# Copy to `.env` and fill in values. Do NOT commit `.env`.

# ----------------------------
# Dataset roots (optional)
# ----------------------------
# PHM-Vibench root directory (used by configs that reference ${PHM_VIBENCH_ROOT})
PHM_VIBENCH_ROOT=/home/user/data/PHMbenchdata/PHM-Vibench

# ----------------------------
# Weights & Biases (optional)
# ----------------------------
# WANDB_API_KEY=your_wandb_api_key
# WANDB_MODE=offline

# ----------------------------
# LLM settings (optional)
# ----------------------------
# Provider: mock | template | openai | anthropic | deepseek | glm
LLM_PRIMARY_PROVIDER=mock
LLM_BASE_URL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

